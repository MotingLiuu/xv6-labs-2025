[
  {
    "label": "xv6 kernel - LLDB DAP",
    "adapter": "CodeLLDB",
    "request": "attach",

    "program": "$ZED_WORKTREE_ROOT/kernel/kernel",

    "preRunCommands": [
      "target modules add \"$ZED_WORKTREE_ROOT/user/_test\"",
      "target modules load --file \"$ZED_WORKTREE_ROOT/user/_test\" --slide 0"
    ],

    "attachCommands": [
      "gdb-remote 127.0.0.1:25501"
    ],

    "stopOnEntry": true
  }
]
