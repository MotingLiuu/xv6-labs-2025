[
  {
    "label": "xv6 kernel + user/_test",
    "adapter": "CodeLLDB",
    "request": "attach",

    "targetCreateCommands": [
      "target create \"$ZED_WORKTREE_ROOT/kernel/kernel\"",
      "target modules add \"$ZED_WORKTREE_ROOT/user/_test\"",
      "target modules load --file _test --slide 0x0"
    ],

    "processCreateCommands": [
      "gdb-remote 127.0.0.1:25501"
    ],

    "stopOnEntry": true
  }
]
